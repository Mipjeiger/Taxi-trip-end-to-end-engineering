FROM python:3.11-slim

WORKDIR /app

# Use faster PyPI mirror (e.g., China mirror or global CDN)
RUN pip config set global.index-url https://pypi.org/simple
RUN pip config set global.extra-index-url https://pypi.python.org/simple

# Install dependencies with timeout and retry
RUN pip install --default-timeout=100 --retries=5 \
    evidently==0.4.0 \
    pandas==2.0.3 \
    numpy==1.24.3 \
    scikit-learn==1.3.0 \
    textblob==0.17.1 \
    pyarrow==14.0.0

# Copy the app code
COPY ./app /app/app
COPY ./evidently /app/evidently

# Create data directory
RUN mkdir -p /app/evidently/llm_data/reports

# Expose port
EXPOSE 8085

# Run Evidently service with a simple HTTP server to serve reports
CMD ["python", "-m", "http.server", "8085", "--directory", "/app/evidently/llm_data/reports"]