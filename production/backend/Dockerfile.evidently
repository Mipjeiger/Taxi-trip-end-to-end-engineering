FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    evidently==0.7.21 \
    litestar>=2.7.0 \
    python-dotenv

COPY start_evidently.py /app/start_evidently.py

EXPOSE 8085

CMD ["python", "/app/start_evidently.py"]